    "scenes": [
      {
        "id": "intro",
        "caption": "A local invoice workflow",
        "transcript": "This is a continuous, scripted demonstration of the local document intelligence workbench. The invoice is fictional, the voice is synthesized, and the product uses real rules parsing. This is not a human review study or a performance benchmark.",
        "started_seconds": 0.02534670796012506,
        "finished_seconds": 14.204243124986533,
        "audio_seconds": 13.96265306122449
      },
      {
        "id": "upload",
        "caption": "Upload and automatic processing",
        "transcript": "I upload the original invoice through the browser. The supervised serial worker parses it in a network denied Docker container and creates an unapproved suggestion. Rules remain the default extractor.",
        "started_seconds": 14.204323124955408,
        "finished_seconds": 26.1055074169999,
        "audio_seconds": 11.701315192743763
      },
      {
        "id": "source",
        "caption": "Inspect cited OCR and review rotation",
        "transcript": "Selecting the invoice number shows its cited OCR line on the source. I rotate the review view and its highlight together, then restore the view. A matching citation does not prove semantic correctness; the reviewer must inspect the document.",
        "started_seconds": 26.134131332975812,
        "finished_seconds": 40.590893832966685,
        "audio_seconds": 14.255986394557823
      },
      {
        "id": "edit",
        "caption": "A correction creates a new revision",
        "transcript": "I demonstrate a correction using the native edit controls, then restore the printed value in another revision. The original suggestion is preserved. An attempted export before approval is refused.",
        "started_seconds": 40.59095208294457,
        "finished_seconds": 52.14051562495297,
        "audio_seconds": 11.28532879818594
      },
      {
        "id": "approve",
        "caption": "Approval binds the current revision",
        "transcript": "The server establishes the local reviewer identity. I approve the current revision. This is an automated fixture approval for the demonstration, not a human quality assessment. Approval never proves that the values are correct.",
        "started_seconds": 52.14057862496702,
        "finished_seconds": 65.85355170798721,
        "audio_seconds": 13.455986394557824
      },
      {
        "id": "export",
        "caption": "Download immutable JSON and CSV",
        "transcript": "The approved revision now produces JSON and CSV downloads. I verify all downloaded bytes against the export store. CSV text is protected against spreadsheet formula interpretation, and earlier exports remain immutable.",
        "started_seconds": 65.87987949996023,
        "finished_seconds": 80.29098312498536,
        "audio_seconds": 14.11732426303855
      },
      {
        "id": "restart",
        "caption": "Restart preserves the committed review",
        "transcript": "I stop this disposable service and reopen the same database and object store. The committed edits and approval survive, and the saved export remains byte identical. Separate crash drills cover incomplete transactions and stale worker fencing.",
        "started_seconds": 80.29109870799584,
        "finished_seconds": 95.10127679194557,
        "audio_seconds": 14.543990929705215
      },
      {
        "id": "reprocess",
        "caption": "Reprocessing requires fresh approval",
        "transcript": "Reprocessing creates a new extraction identity and revision using the verified parser checkpoint. The earlier approved export survives, but the new candidate needs fresh approval. Review authority is separate from extraction.",
        "started_seconds": 95.10135612497106,
        "finished_seconds": 109.13979408296291,
        "audio_seconds": 13.743990929705216
      },
      {
        "id": "limits",
        "caption": "Measured results and release limits",
        "transcript": "On the declared synthetic invoice comparison, the optional local model regresses against rules and is not promoted. The author pilot retains two errors in approved records. Genuine scanner validation, manual semantic assessments and remaining release gates are still pending. This project makes no time saved or unattended approval claim.",
        "started_seconds": 109.1398506249534,
